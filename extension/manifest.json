{
  "manifest_version": 3,
  "name": "VIN History Monitor",
  "version": "1.2.0",
  "description": "Monitora o campo VIN de formularios (Google Forms, Microsoft Forms), registra cada valor com a hora, destaca duplicatas (remocao automatica opcional) e mostra um calendario de historico por dia.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://docs.google.com/forms/*",
    "https://forms.office.com/*",
    "https://forms.microsoft.com/*",
    "https://forms.cloud.microsoft/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/forms/*",
        "https://forms.office.com/*",
        "https://forms.microsoft.com/*",
        "https://forms.cloud.microsoft/*"
      ],
      "js": ["storage.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Historico de VIN"
  }
}
